# ---- Tone Neuron settings (copy to .env) -------------------------------------
# Everything is optional: with an empty .env the project runs fully offline.

# Who the assistant is talking to (used for coaching tone only)
TONE_NEURON_OWNER_NAME=there
# Default region used when inference is ambiguous (JP|IN|DE|US|UK|CN|BR|AE)
TONE_NEURON_HOME_REGION=US
# Language the user is learning / writing in (ISO-639-1)
TONE_NEURON_TARGET_LANGUAGE=en

# Knowledge / retrieval
# embedder: auto | hashing | tfidf | st  (st = sentence-transformers, needs download)
TONE_NEURON_EMBEDDER=auto
# vector_store: auto | numpy | faiss | qdrant
TONE_NEURON_VECTOR_STORE=auto
# reranker: auto | lexical | cross-encoder | none
TONE_NEURON_RERANKER=auto
TONE_NEURON_MMR_LAMBDA=0.65
TONE_NEURON_TOP_K=5

# Optional OpenAI-compatible LLM for Task C rewrites (off by default)
TONE_NEURON_ENABLE_LLM=false
TONE_NEURON_LLM_BASE_URL=https://api.openai.com/v1
TONE_NEURON_LLM_API_KEY=
TONE_NEURON_LLM_MODEL=gpt-4o-mini

# Privacy: in-memory session store only (no email content is ever written)
TONE_NEURON_MAX_EVENTS=200
TONE_NEURON_SESSION_TTL_HOURS=24

# Gmail API (read-only). Create an OAuth desktop client, save the JSON below.
TONE_NEURON_GMAIL_CREDENTIALS_FILE=~/.tone-neuron/credentials.json
TONE_NEURON_GMAIL_TOKEN_FILE=~/.tone-neuron/token.json

# Backend
TONE_NEURON_API_HOST=127.0.0.1
TONE_NEURON_API_PORT=8000
TONE_NEURON_API_BASE_URL=http://127.0.0.1:8000
